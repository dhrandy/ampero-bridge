# Copy to .env next to docker-compose.yml. Docker Compose reads it automatically.
# In Dockhand, put the same line in the stack's Environment tab instead.
API_KEY=change-me-to-a-long-random-string
# Optional: host folder for patch backups (default: ./backups next to docker-compose.yml).
# Use an absolute path in Dockhand, for example /srv/ampero-backups
# BACKUP_DIR=/srv/ampero-backups
