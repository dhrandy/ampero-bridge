# Copy to .env next to docker-compose.yml. Docker Compose reads it automatically.
# In Dockhand, put the same line in the stack's Environment tab instead.
API_KEY=change-me-to-a-long-random-string
# Optional: host folder for the remembered patch names (default: ./data next to docker-compose.yml).
# Use an absolute path in Dockhand, for example /srv/ampero-data
# DATA_DIR=/srv/ampero-data
