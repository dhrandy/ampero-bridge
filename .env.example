# Copy to .env next to docker-compose.yml. Docker Compose reads it automatically.
# In Dockhand, put the same names in the stack's Environment tab instead (no .env file needed).

# Required. Long random string, at least 24 characters: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Optional: host folder for names, notes, stars and backups (default: ./data next to docker-compose.yml).
# Use an absolute path in Dockhand, for example /srv/ampero-data
# DATA_DIR=/srv/ampero-data

# Optional: page origin allowed to call the API from a browser, for the site's bridge panel.
# Blank means no browser page can. Several origins go in one line, comma separated.
AMPERO_CORS_ORIGINS=

# Optional: how many patches a backup walks through (blank means 100).
AMPERO_PATCH_COUNT=

# Optional: set to 1 to let /api/model send model codes not yet proven. Blank means off.
AMPERO_ALLOW_UNPROVEN_MODELS=
